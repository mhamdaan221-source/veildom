# Copy this file to .env and replace the chosen provider's placeholder locally.
# Never commit or paste a real token into chat.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-replace_with_your_key
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Optional Hugging Face alternative:
# AI_PROVIDER=huggingface
# HF_TOKEN=hf_replace_with_your_token
# HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
